# ===== Muse API (muse2api) =====
# Alamat lengkap API yang diakses browser: harus IP publik/internal atau domain server ini, jangan diakhiri /, jangan tambahkan /v1
# Di Dokploy (fork ini): MUSE_API_BASE diisi alamat muse2api live, MUSE_API_KEY diisi lewat env Dokploy.
MUSE_API_BASE=http://127.0.0.1:1314
# Kunci akses bersama browser dan API (skrip instalasi akan membuat nilai acak secara otomatis)
MUSE_API_KEY=change-me
# Nama yang ditampilkan di channel kanvas
MUSE_CHANNEL_NAME=Muse

MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=1314
# Jumlah tugas Muse yang berjalan bersamaan; makin bagus mesinnya bisa dinaikkan ke 4
MUSE2API_CONCURRENCY=2
# Kosongkan untuk deteksi otomatis chromium / google-chrome; bisa juga diisi /usr/bin/chromium
MUSE2API_CHROMIUM=

# ===== Agent server (Codex + DeepSeek) =====
# Saat instalasi bisa langsung export DEEPSEEK_API_KEY=sk-... lalu jalankan install.sh
DEEPSEEK_API_KEY=

# ===== Kanvas Tak Terbatas =====
CANVAS_HOST=0.0.0.0
CANVAS_PORT=521
CANVAS_ROOT=

TZ=Asia/Jakarta

# Catatan: alamat koneksi dan Token Agent tidak lagi ditaruh di sini.
# Satu-satunya sumber adalah /Muse/agent/.infinite-canvas/canvas-agent.json
# Setelah diubah, restart muse-agent dan muse-canvas.
# Saat instalasi, nilai default yang ditulis ke JSON bisa ditimpa dengan variabel lingkungan AGENT_PUBLIC_URL / AGENT_ORIGINS.
